ARG WORKER_IMAGE
FROM ${WORKER_IMAGE}
USER 0:0
COPY modarchitect-*.whl /tmp/
RUN PY=/opt/miniconda3/envs/sumfen_mlgrowth/bin/python && \
    $PY -c "import hashlib,pathlib,rasterio; from osgeo import gdal; assert gdal.GetDriverByName('HDF4'); pathlib.Path('/tmp/modarchitect-gis-before').write_text(rasterio.__gdal_version__+' '+hashlib.sha256(pathlib.Path(rasterio.__file__).read_bytes()).hexdigest())" && \
    $PY -m pip list --format=freeze > /tmp/modarchitect-existing-constraints.txt && \
    $PY -m pip install --no-cache-dir --constraint /tmp/modarchitect-existing-constraints.txt /tmp/modarchitect-*.whl && \
    $PY -c "import hashlib,pathlib,rasterio; from osgeo import gdal; assert gdal.GetDriverByName('HDF4'); assert pathlib.Path('/tmp/modarchitect-gis-before').read_text()==rasterio.__gdal_version__+' '+hashlib.sha256(pathlib.Path(rasterio.__file__).read_bytes()).hexdigest(); import modarchitect.api,modarchitect.runtime.worker,modarchitect.input_sources.worker,pymlgrowth.cli.crop,mlgrowth_enterprise; print('Modarchitect and existing Worker imports passed; GIS unchanged')" && \
    rm /tmp/modarchitect-*.whl /tmp/modarchitect-existing-constraints.txt /tmp/modarchitect-gis-before
