ARG BASE_IMAGE
FROM ${BASE_IMAGE}
USER 0:0
ARG PYTHON_PATH=/usr/local/bin/python
ARG RUN_USER=65532:65532
COPY modarchitect-*.whl /tmp/
RUN ${PYTHON_PATH} -m pip install --no-deps --no-index --force-reinstall /tmp/modarchitect-*.whl && \
    ${PYTHON_PATH} -c "import modarchitect.api, modarchitect.input_sources.soil; from modarchitect.study_templates import templates; assert len(templates()) == 20" && \
    rm /tmp/modarchitect-*.whl
USER ${RUN_USER}
