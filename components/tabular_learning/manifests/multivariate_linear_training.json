{
  "manifest_version": "1.1",
  "component": {
    "code": "multivariate_linear_training",
    "revision": 1,
    "name": "多变量线性模型训练",
    "category": "training"
  },
  "contract": {
    "summary": "用多个已知因子预测一个或多个数值目标。",
    "method": "普通最小二乘",
    "requirements": [
      "训练期每行应有完整的候选因子及实测目标。",
      "预测期每行应提供同口径的候选因子。"
    ],
    "limitations": [
      "用于线性基线，缺失值和不满秩的训练数据会被拒绝。",
      "真实预测需独立评价，并核对各因子在预测时已可用。"
    ],
    "inputs": [
      {
        "code": "observations",
        "name": "观测输入",
        "data_type": {
          "semantic": "research_observation_table",
          "version": 1,
          "shape": "table",
          "unit": "column_definitions",
          "alignment": "business_date"
        },
        "required": true,
        "description": "包含已对齐的候选因子和目标。",
        "projection": "identity",
        "allow_none": false,
        "output_view": null
      }
    ],
    "outputs": [
      {
        "code": "trained_model",
        "name": "训练后的模型",
        "data_type": {
          "semantic": "multivariate_linear_model",
          "version": 2,
          "shape": "bundle",
          "unit": "native_contract",
          "alignment": "context"
        },
        "required": true,
        "description": "按目标保存截距和各输入变量系数。",
        "projection": "identity",
        "allow_none": false,
        "output_view": null
      },
      {
        "code": "predictions",
        "name": "预测结果表",
        "data_type": {
          "semantic": "research_prediction_table",
          "version": 1,
          "shape": "table",
          "unit": "column_definitions",
          "alignment": "business_date"
        },
        "required": true,
        "description": "按地块、业务日期和目标输出预测数值。",
        "projection": "identity",
        "allow_none": false,
        "output_view": null
      }
    ],
    "request_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "features": {
          "title": "输入变量",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,95}$"
          },
          "x-research-variables": {
            "table_port": "observations",
            "roles": [
              "covariate",
              "driver"
            ]
          }
        },
        "targets": {
          "title": "预测目标",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,95}$"
          },
          "x-research-variables": {
            "table_port": "observations",
            "roles": [
              "target"
            ],
            "observed": true,
            "evaluation_target": true
          }
        },
        "training_end": {
          "title": "训练截止日期",
          "type": "string",
          "format": "date",
          "description": "使用截至当天的记录训练，对之后日期的已知因子计算预测值。"
        }
      },
      "required": [
        "features",
        "targets",
        "training_end"
      ]
    },
    "execution": {
      "operations": [
        "train"
      ],
      "state_output": "trained_model",
      "inference": {
        "code": "multivariate_linear_predict",
        "revision": 1
      },
      "input_uses": {
        "features": {
          "role": "feature",
          "phases": [
            "training",
            "application"
          ]
        },
        "targets": {
          "role": "label",
          "phases": [
            "training",
            "evaluation"
          ]
        }
      }
    }
  },
  "artifact": {
    "kind": "oci_image",
    "manifest_digest": "sha256:3fc497670ac1229160deb4c39106aea1ca53106d41ba2235e7ebd2c51246758f"
  },
  "runtime": {
    "protocol_version": "1.0",
    "profile_code": "offline_cpu"
  }
}
