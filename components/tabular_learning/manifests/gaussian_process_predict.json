{
  "manifest_version": "1.1",
  "component": {
    "code": "gaussian_process_predict",
    "revision": 1,
    "name": "高斯过程模型预测",
    "category": "learning"
  },
  "contract": {
    "summary": "使用已保存的模型与已知因素预测，不重新训练。",
    "method": "训练集标准化与固定RBF核精确高斯过程，alpha=0.01",
    "requirements": [
      "训练标签须为实测，因素与目标不得重叠；输入按完整对象及业务日期对齐。",
      "模型使用前须用独立资料验证适用性；因素在预测时必须已知。"
    ],
    "limitations": [
      "本版本只处理完整有限数值，不自动补值或合成实测标签。",
      "同一地块的多个日期不代表多个独立试验单位。",
      "高斯过程每次最多1000个训练样本；树方法最多10000个，按资源预算执行。"
    ],
    "inputs": [
      {
        "code": "observations",
        "name": "观测输入",
        "data_type": {
          "semantic": "research_observation_table",
          "version": 1,
          "shape": "table",
          "unit": "column_definitions",
          "alignment": "business_date"
        },
        "required": true,
        "description": "包含已对齐的候选因子和目标。",
        "projection": "identity",
        "allow_none": false,
        "output_view": null
      },
      {
        "code": "model",
        "name": "准确训练模型",
        "data_type": {
          "semantic": "gaussian_process_regression_model",
          "version": 1,
          "shape": "bundle",
          "unit": "native_contract",
          "alignment": "context"
        },
        "required": true,
        "description": "获准模型制品的状态及列定义",
        "projection": "identity",
        "allow_none": false,
        "output_view": null
      }
    ],
    "outputs": [
      {
        "code": "predictions",
        "name": "预测结果表",
        "data_type": {
          "semantic": "research_prediction_table",
          "version": 1,
          "shape": "table",
          "unit": "column_definitions",
          "alignment": "business_date"
        },
        "required": true,
        "description": "按地块、业务日期和目标输出预测数值。",
        "projection": "identity",
        "allow_none": false,
        "output_view": null
      }
    ],
    "request_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    },
    "execution": {
      "operations": [
        "predict"
      ],
      "state_output": null,
      "inference": null,
      "input_uses": {}
    }
  },
  "artifact": {
    "kind": "oci_image",
    "manifest_digest": "sha256:52abecf408abf1a25ba110923114369bee54a022101d0d03bd2c052ff89c8e0c"
  },
  "runtime": {
    "protocol_version": "1.0",
    "profile_code": "offline_cpu"
  }
}
