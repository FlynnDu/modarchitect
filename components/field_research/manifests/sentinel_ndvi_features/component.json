{
  "manifest_version": "1.1",
  "component": {
    "code": "sentinel_ndvi_features",
    "revision": 1,
    "name": "卫星NDVI计算与土壤气象配对",
    "category": "transform"
  },
  "contract": {
    "summary": "明确计算NDVI，并与同对象同日的土壤、气象及实测目标配对。",
    "method": "NDVI=(B08−B04)/(B08+B04)，完整对象与日期严格配对",
    "requirements": [
      "三组输入严格按完整地块、作物、种植季和实际卫星业务日期配对。",
      "反射率为已验证准确来源的无量纲估计值；不能用拉伸显示像素替代。"
    ],
    "limitations": [
      "无清晰场景不产生该日NDVI，不能伪造逐日连续观测。",
      "参考网格不是整个地块均值；数据性质和支撑随源快照保留。",
      "分母接近零或不合格反射率拒绝计算；NDVI为派生量，不授予实测标签资格。"
    ],
    "inputs": [
      {
        "code": "observations",
        "name": "气象与实测目标",
        "description": "准确来源与单位的数值观测",
        "data_type": {
          "semantic": "research_observation_table",
          "version": 1,
          "shape": "table",
          "unit": "column_definitions",
          "alignment": "business_date"
        }
      },
      {
        "code": "soil",
        "name": "准确土层参考",
        "description": "准确来源与单位的数值观测",
        "data_type": {
