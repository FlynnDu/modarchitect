[
  {
    "code": "research_weather_conditions",
    "revision": 1,
    "name": "气象条件分析",
    "category": "assessment",
    "summary": "气象条件分析",
    "execution_mode": "external_cli",
    "implementation": {
      "module": "modarchitect_agronomy.weather",
      "symbol": "conditions",
      "source_sha256": "8b9f5325fd037a0af1c508d7a02a5d90350a89c7998c91f8855c122196fc74f0"
    },
    "algorithm": "既有逐变量来源资格与气象规则",
    "mechanism": "按实际科学输入独立计算，保留不足样本与适用范围",
    "inputs": [
      {
        "code": "weather",
        "name": "逐日气象数据",
        "description": "保留来源、单位和实际值性质的数据",
        "data_type": {
          "semantic": "qualified_weather_research_data",
          "version": 1,
          "shape": "bundle",
          "unit": "native_contract",
          "alignment": "business_date"
        }
      },
      {
        "code": "request",
        "name": "研究设置",
        "description": "允许调整的研究指标和日期",
        "data_type": {
          "semantic": "research_weather_conditions_request",
          "version": 1,
          "shape": "bundle",
          "unit": "native_contract",
          "alignment": "context"
        }
      }
    ],
    "outputs": [
      {
        "code": "report",
        "name": "条件分析结果",
        "description": "研究结果、数据覆盖和解释范围",
        "data_type": {
          "semantic": "research_weather_conditions_report",
          "version": 1,
          "shape": "bundle",
          "unit": "native_contract",
          "alignment": "context"
        }
      }
    ],
    "requirements": [
      "输入为已对齐并封存的标准数值观测。"
    ],
    "limitations": [
      "多天观测不等于多个独立试验单位。",
      "样本标准差至少需要两条记录；单条记录返回空值。"
    ],
    "configuration": {
      "research_model": {
        "kind": "analysis",
        "request_schema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "rule": {
              "type": "string",
              "enum": [
                "frost_exposure",
                "heat_exposure",
                "rainfall_deficit",
                "rainfall_excess",
                "warm_humid_disease"
              ]
            },
            "as_of": {
              "title": "分析截止日期",
              "type": "string",
              "format": "date"
            },
            "crop_code": {
              "title": "研究作物",
              "type": "string",
              "enum": [
                "potato",
                "wheat",
                "maize",
                "tomato"
              ]
            }
          },
          "required": [
            "rule",
            "as_of",
            "crop_code"
          ]
        },
        "execution": {
          "operations": [
            "analyze"
          ]
        }
      }
    },
    "composable": true,
    "native_parameters": [
      {
        "code": "weather",
        "required": true
      },
      {
        "code": "request",
        "required": true
      }
    ]
  },
  {
    "code": "agronomic_indicator_analysis",
    "revision": 1,
    "name": "农业指标过程分析",
    "category": "assessment",
    "summary": "农业指标过程分析",
    "execution_mode": "external_cli",
    "implementation": {
      "module": "modarchitect_agronomy.series",
      "symbol": "process",
      "source_sha256": "ef37ebc7f901708418da37e701d154771533f4f62e8bef0c0444bff8bd2830f6"
    },
    "algorithm": "逐指标统计、时序变化与同日描述性相关",
    "mechanism": "按实际科学输入独立计算，保留不足样本与适用范围",
    "inputs": [
      {
        "code": "series",
        "name": "农业指标数据",
        "description": "保留来源、单位和实际值性质的数据",
        "data_type": {
          "semantic": "agronomic_indicator_series",
          "version": 1,
          "shape": "bundle",
          "unit": "native_contract",
          "alignment": "business_date"
        }
      },
      {
        "code": "request",
        "name": "研究设置",
        "description": "允许调整的研究指标和日期",
        "data_type": {
          "semantic": "agronomic_indicator_analysis_request",
          "version": 1,
          "shape": "bundle",
          "unit": "native_contract",
          "alignment": "context"
        }
      }
    ],
    "outputs": [
      {
        "code": "report",
        "name": "指标过程与关系结果",
        "description": "研究结果、数据覆盖和解释范围",
        "data_type": {
          "semantic": "agronomic_indicator_analysis_report",
          "version": 1,
          "shape": "bundle",
          "unit": "native_contract",
          "alignment": "context"
        }
      }
    ],
    "requirements": [
      "输入为已对齐并封存的标准数值观测。"
    ],
    "limitations": [
      "多天观测不等于多个独立试验单位。",
      "样本标准差至少需要两条记录；单条记录返回空值。"
    ],
    "configuration": {
      "research_model": {
        "kind": "analysis",
        "request_schema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "variables": {
              "title": "研究指标",
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,95}$"
              }
            },
            "start_date": {
              "title": "研究开始日期",
              "type": "string",
              "format": "date"
            },
            "end_date": {
              "title": "研究结束日期",
              "type": "string",
              "format": "date"
            }
          },
          "required": [
            "variables",
            "start_date",
            "end_date"
          ]
        },
        "execution": {
          "operations": [
            "analyze"
          ]
        }
      }
    },
    "composable": true,
    "native_parameters": [
      {
        "code": "series",
        "required": true
      },
      {
        "code": "request",
        "required": true
      }
    ]
  }
]
