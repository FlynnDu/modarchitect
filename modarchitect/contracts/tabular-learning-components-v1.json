      "高斯过程每次最多1000个训练样本；树方法最多10000个，按资源预算执行。"
    ],
    "configuration": {
      "research_model": {
        "request_schema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "features": {
              "title": "输入变量",
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,95}$"
              },
              "x-research-variables": {
                "table_port": "observations",
                "roles": [
                  "covariate",
                  "driver"
                ]
              }
            },
            "targets": {
              "title": "预测目标",
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,95}$"
              },
              "x-research-variables": {
                "table_port": "observations",
                "roles": [
                  "target"
                ],
                "observed": true,
                "evaluation_target": true
              }
            },
            "training_end": {
              "title": "训练截止日期",
              "type": "string",
              "format": "date",
              "description": "使用截至当天的记录训练，对之后日期的已知因子计算预测值。"
            },
            "seed": {
              "title": "复现种子",
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647,
              "default": 17
            }
          },
          "required": [
            "features",
            "targets",
            "training_end"
          ]
        },
        "kind": "regression",
        "execution": {
          "operations": [
            "train"
          ],
          "state_output": "trained_model",
          "inference": {
            "code": "random_forest_predict",
            "revision": 1
          },
          "input_uses": {
            "features": {
              "role": "feature",
              "phases": [
                "training",
                "application"
              ]
            },
            "targets": {
              "role": "label",
              "phases": [
                "training",
                "evaluation"
              ]
            }
          }
        },
        "table_outputs": {
          "predictions": {
            "predicted": [
              "targets"
            ],
            "fit_through": "training_end"
          }
        }
      },
      "call_kwargs": {
        "algorithm": "random_forest"
      }
    },
    "native_parameters": [
      {
        "code": "observations",
        "required": true
      },
