{
  "code": "multivariate_linear_regression",
  "revision": 1,
  "name": "多变量线性回归",
  "category": "training",
  "summary": "用多个已知因子预测一个或多个数值目标。",
  "algorithm": "普通最小二乘",
  "mechanism": "按日期截点切分，通过普通最小二乘拟合各目标。",
  "execution_mode": "external_cli",
  "composable": true,
  "requires_instance": true,
  "implementation": {
    "module": "components.multivariate_regression.component",
    "symbol": "train_predict",
    "source_sha256": "fc7d9117d70e4dcf4a481384fd56a356857136364c85a777fbffffd5765e90ba"
  },
  "inputs": [
    {
      "code": "observations",
      "name": "观测输入",
      "description": "包含已对齐的候选因子和目标。",
      "data_type": {
        "semantic": "research_observation_table",
        "version": 1,
        "shape": "table",
        "unit": "column_definitions",
        "alignment": "business_date"
      }
    },
    {
      "code": "request",
      "name": "组件配置",
      "description": "输入变量、预测目标和训练截止日期。",
      "data_type": {
        "semantic": "multivariate_regression_request",
        "version": 1,
        "shape": "bundle",
        "unit": "native_contract",
        "alignment": "context"
      }
    }
  ],
  "outputs": [
    {
      "code": "trained_model",
      "name": "训练后的模型",
      "description": "按目标保存截距和各输入变量系数。",
      "data_type": {
        "semantic": "multivariate_linear_model",
        "version": 1,
        "shape": "bundle",
        "unit": "native_contract",
        "alignment": "context"
      }
    },
    {
      "code": "predictions",
      "name": "预测结果表",
      "description": "按地块、业务日期和目标输出预测数值。",
      "data_type": {
        "semantic": "research_prediction_table",
        "version": 1,
        "shape": "table",
        "unit": "column_definitions",
        "alignment": "business_date"
      }
    }
  ],
  "requirements": [
    "训练期每行应有完整的候选因子及实测目标。",
    "预测期每行应提供同口径的候选因子。"
  ],
  "limitations": [
    "用于线性基线，缺失值和不满秩的训练数据会被拒绝。",
    "真实预测需独立评价，并核对各因子在预测时已可用。"
  ],
  "configuration": {
    "research_model": {
      "request_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "features": {
            "title": "输入变量",
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,95}$"
            },
            "x-research-variables": {
              "table_port": "observations",
              "roles": [
                "covariate",
                "driver"
              ]
            }
          },
          "targets": {
            "title": "预测目标",
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,95}$"
            },
            "x-research-variables": {
              "table_port": "observations",
              "roles": [
                "target"
              ],
              "observed": true,
              "evaluation_target": true
            }
          },
          "training_end": {
            "title": "训练截止日期",
            "type": "string",
            "format": "date",
            "description": "使用截至当天的记录训练，对之后日期的已知因子计算预测值。"
          }
        },
        "required": [
          "features",
          "targets",
          "training_end"
        ]
      }
    },
